{
  // Shared workspace settings. Committed on purpose — see .gitignore, which
  // re-includes exactly the files in this directory that the team shares.
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "backend/momento.db*": true,
    "frontend/.vite": true
  },
  "search.exclude": {
    "dist": true,
    "node_modules": true,
    "public/momento-source.zip": true,
    "frontend/lib/source-archive.json": true
  },
  "files.associations": {
    "*.agent.md": "markdown",
    "*.instructions.md": "markdown"
  },
  "editor.rulers": [88, 100],
  "editor.tabSize": 2,
  "[python]": {
    "editor.tabSize": 4
  },

  // TypeScript / React
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "javascript.preferences.importModuleSpecifier": "non-relative",
  "tailwindCSS.classFunctions": ["cn", "cva"],
  "tailwindCSS.experimental.configFile": "tailwind.config.ts",

  // Python: the kernel plus the pytest suite. Tests must run from backend/.
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],
  "python.testing.cwd": "${workspaceFolder}/backend",
  "python.analysis.extraPaths": ["${workspaceFolder}/backend"],

  // Copilot: honour AGENTS.md and the scoped instruction files.
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,
  "chat.instructionsFilesLocations": {
    ".github/instructions": true
  },
  // NOTE: skills in `.agents/skills/` need no setting — VS Code discovers
  // project skills from `.github/skills/`, `.claude/skills/` and `.agents/skills/`
  // automatically. `chat.agentSkillsLocations` is deprecated, and
  // `chat.promptFilesLocations` is for prompt files (`.github/prompts`), so
  // pointing it at the skills directory did nothing.

  // The frontend calls http://localhost:8000; nothing is proxied.
  "liveServer.settings.port": 5173
}
