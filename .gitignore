# Dependencies
node_modules/
# Python virtualenvs. `.vscode/settings.json` and `.vscode/launch.json` pin the
# interpreter to `backend/.venv`, so the env is expected to exist and must never
# be committed. `venv/` is the older path and is ignored too so a stray one
# cannot be staged by accident.
venv/
.venv/
env/
ENV/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/
*.egg

# Database files
momento.db
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Watcher runtime state (persisted seen-file cache, rebuilt on first run)
watcher_seen.json

# Local evidence corpus (prior-data DBs used by /api/seed — user data, not code)
seed/

# Data files
data/rounds.json
data/*.json

# Build artifacts
frontend/.vite/
frontend/dist/
frontend/package-lock.json

# IDE
# `.vscode/*` rather than `.vscode/`: a trailing-slash pattern excludes the
# directory itself, and git will not re-include a file whose parent directory is
# excluded — so the `!` rules below silently did nothing and NONE of the shared
# workspace config was ever tracked. The glob form excludes the contents while
# leaving the negations working.
.vscode/*
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
*.temp
server_backup/
data_backup/

# Devin
.devin/config.local.json
.devin/mcp_config.local.json

# Personal AI rules (kept local on purpose)
AGENTS.local.md
CLAUDE.local.md

# Shared IDE/AI config: .vscode/ is ignored above, but these files are part of
# the project's AI setup and are tracked deliberately.
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
